# CYBERSHIELD Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Security (Generate a secure 32+ character random string in production)
SECRET_KEY=cybershield-production-super-secret-key-32-chars-minimum-replace-me-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default local zero-config SQLite:
DATABASE_URL=sqlite:///./cybershield.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://cybershield_user:cybershield_pass@localhost:5432/cybershield_db

# File & Evidence Vault Storage
STORAGE_DIR=./storage/evidence
MAX_UPLOAD_SIZE_BYTES=15728640

# SSRF Controls
SSRF_REQUEST_TIMEOUT_SECONDS=3.0
SSRF_MAX_RESPONSE_BYTES=524288

# Threat Intelligence Feed API Keys (Optional external enrichers)
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_API_KEY=
